        </main>
    </div>
</div>

<%--
    Sec. 45's "clear feedback" for actions that redirect rather than
    forward (ResultApprovalServlet's publish/lock/bulk-publish/bulk-lock,
    AdminRevaluationServlet's resolve, NotificationServlet) - these set
    sessionScope.flashSuccess/flashError before sendRedirect() specifically
    because a redirect starts a brand-new request that request-scope
    attributes cannot survive. Rendered here, once, in the fragment every
    admin page already includes, rather than each of those servlets'
    target pages remembering to check for it individually - this is
    exactly the gap that meant none of them actually showed anything
    before this fragment existed.
    Passed through a hidden element's data-attribute (c:out's normal HTML
    escaping) rather than interpolated directly into a script's source
    text - a message containing an apostrophe (an exam or notice title,
    say) would otherwise break out of a single-quoted JS string literal.
    c:remove clears each one immediately after reading so it never
    reappears on the next page navigation.
--%>
<c:if test="${not empty sessionScope.flashSuccess}">
    <div id="flashSuccessData" data-message="<c:out value='${sessionScope.flashSuccess}'/>" style="display:none;"></div>
    <c:remove var="flashSuccess" scope="session"/>
</c:if>
<c:if test="${not empty sessionScope.flashError}">
    <div id="flashErrorData" data-message="<c:out value='${sessionScope.flashError}'/>" style="display:none;"></div>
    <c:remove var="flashError" scope="session"/>
</c:if>

<script>
  // Sec. 42/45's "Loading states" / "clear feedback" - one global handler
  // rather than editing every form across the app individually. Listens
  // in the bubble phase (the default), so it always runs AFTER a page's
  // own submit handler attached directly to that form (e.g.
  // student-import.jsp's course-required check) - checking
  // e.defaultPrevented means a validation failure that legitimately
  // blocks submission is never mistaken for a real, in-flight request.
  document.addEventListener('submit', function (e) {
    if (e.defaultPrevented) { return; }
    var submitBtn = e.target.querySelector('button[type="submit"]:not([disabled]), input[type="submit"]:not([disabled])');
    if (submitBtn) {
      setTimeout(function () {
        submitBtn.disabled = true;
      }, 0);
      if (submitBtn.tagName === 'INPUT') {
        submitBtn.dataset.originalText = submitBtn.value;
        submitBtn.value = 'Processing\u2026';
      } else {
        submitBtn.dataset.originalText = submitBtn.textContent;
        submitBtn.textContent = 'Processing\u2026';
      }
    }
  });

  // Opens/closes the mobile sidebar; called by the .mobile-menu-btn in admin-head.jspf.
  function toggleSidebar() {
    var sidebar = document.getElementById('sidebar');
    var isOpen = sidebar.classList.toggle('open');
    var btn = document.querySelector('.mobile-menu-btn');
    if (btn) { btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false'); }
  }

  (function () {
    var successEl = document.getElementById('flashSuccessData');
    if (successEl) {
      if (typeof toastr !== 'undefined') { toastr.success(successEl.dataset.message); }
      else { console.log('SUCCESS:', successEl.dataset.message); }
    }
    var errorEl = document.getElementById('flashErrorData');
    if (errorEl) {
      if (typeof toastr !== 'undefined') { toastr.error(errorEl.dataset.message); }
      else { console.error('ERROR:', errorEl.dataset.message); }
    }
  })();
</script>
</body>
</html>
