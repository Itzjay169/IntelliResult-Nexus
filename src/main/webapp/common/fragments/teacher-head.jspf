<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%--
    Teacher counterpart to admin-head.jspf - same static-include reasoning
    (needs the including page's own request attributes, particularly which
    nav link is "active"), same tokens.css + app-shell.css pair. app-shell.css
    was renamed from admin-shell.css in this phase specifically so this
    fragment linking it isn't a lie: every selector inside (.shell, .sidebar,
    .topbar, .stat-card, .panel...) was already role-agnostic, just filed
    under a name that assumed only Admin would ever use it.
    Sidebar nav is Sec. 69's full Teacher list, including two links
    (Student Performance, Re-evaluations) with no route behind them yet -
    same "pre-wire the whole nav, not just what's built so far" choice
    admin-head.jspf made from Phase 5a onward (see NavigationUtil's own note
    on why that's an honest "not built yet," not a bug).
    Expects the including page to have already set pageTitle and, optionally,
    pageSubtitle as request attributes before this include.
--%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${pageTitle}"/> - IntelliResult Nexus</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/tokens.css">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app-shell.css">
    <%-- Same library set and reasoning as admin-head.jspf (see its comment). --%>
    <link rel="stylesheet" href="https://cdn.datatables.net/2.1.8/css/dataTables.dataTables.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/3.0.8/css/responsive.dataTables.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/css/toastr.min.css">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/2.1.8/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/3.0.8/js/dataTables.responsive.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/js/toastr.min.js"></script>
    <script>$.fn.dataTable.defaults.responsive = true;</script>
</head>
<body>
<a href="#main-content" class="skip-link">Skip to main content</a>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<c:set var="currentPath" value="${pageContext.request.servletPath}"/>

<div class="shell">
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">IntelliResult <span>Nexus</span></div>

        <nav class="sidebar-nav">
            <div class="sidebar-group">
                <a class="sidebar-link ${currentPath == '/teacher/dashboard' ? 'active' : ''}" href="${ctx}/teacher/dashboard">
                    <span class="dot"></span>Dashboard
                </a>
            </div>

            <div class="sidebar-group">
                <div class="sidebar-group-label">My Teaching</div>
                <a class="sidebar-link ${currentPath == '/teacher/my-classes' ? 'active' : ''}" href="${ctx}/teacher/my-classes"><span class="dot"></span>My Classes</a>
                <a class="sidebar-link ${currentPath == '/teacher/my-subjects' ? 'active' : ''}" href="${ctx}/teacher/my-subjects"><span class="dot"></span>My Subjects</a>
            </div>

            <div class="sidebar-group">
                <div class="sidebar-group-label">Examinations</div>
                <a class="sidebar-link ${currentPath == '/teacher/exams' ? 'active' : ''}" href="${ctx}/teacher/exams"><span class="dot"></span>Exams</a>
                <a class="sidebar-link ${currentPath == '/teacher/marks-entry' ? 'active' : ''}" href="${ctx}/teacher/marks-entry"><span class="dot"></span>Marks Entry</a>
                <a class="sidebar-link ${currentPath == '/teacher/draft-results' ? 'active' : ''}" href="${ctx}/teacher/draft-results"><span class="dot"></span>Draft Results</a>
                <a class="sidebar-link ${currentPath == '/teacher/submitted-results' ? 'active' : ''}" href="${ctx}/teacher/submitted-results"><span class="dot"></span>Submitted Results</a>
            </div>

            <div class="sidebar-group">
                <div class="sidebar-group-label">Insights</div>
                <a class="sidebar-link ${currentPath == '/teacher/student-performance' ? 'active' : ''}" href="${ctx}/teacher/student-performance"><span class="dot"></span>Student Performance</a>
                <a class="sidebar-link ${currentPath == '/teacher/revaluations' ? 'active' : ''}" href="${ctx}/teacher/revaluations"><span class="dot"></span>Re-evaluations</a>
            </div>

            <div class="sidebar-group">
                <div class="sidebar-group-label">Communication</div>
                <a class="sidebar-link ${currentPath == '/teacher/notifications' ? 'active' : ''}" href="${ctx}/teacher/notifications">
                    <span class="dot"></span>Notifications
                    <c:if test="${not empty unreadNotificationCount and unreadNotificationCount > 0}">
                        <span class="nav-badge">${unreadNotificationCount}</span>
                    </c:if>
                </a>
            </div>

            <div class="sidebar-group">
                <div class="sidebar-group-label">Activity</div>
                <a class="sidebar-link ${currentPath == '/teacher/activity' ? 'active' : ''}" href="${ctx}/teacher/activity"><span class="dot"></span>My Activity</a>
            </div>
        </nav>

        <div class="sidebar-footer">
            <div class="sidebar-user-name"><c:out value="${sessionScope.sessionUserName}"/></div>
            <div class="sidebar-user-role"><c:out value="${sessionScope.sessionUserRole}"/></div>
            <form method="post" action="${ctx}/logout">
                <input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}">
                <button type="submit" class="sidebar-footer-link">Sign out</button>
            </form>
        </div>
    </aside>

    <div class="content">
        <header class="topbar">
            <div style="display:flex; align-items:center; gap:var(--space-3);">
                <button type="button" class="mobile-menu-btn" onclick="toggleSidebar()"
                        aria-label="Toggle navigation menu" aria-controls="sidebar" aria-expanded="false">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
                    </svg>
                </button>
                <div>
                    <h1 class="topbar-title"><c:out value="${pageTitle}"/></h1>
                    <c:if test="${not empty pageSubtitle}">
                        <p class="topbar-subtitle"><c:out value="${pageSubtitle}"/></p>
                    </c:if>
                </div>
            </div>
            <div style="display:flex; align-items:center; gap:var(--space-4);">
                <a href="${ctx}/teacher/notifications" style="position:relative; display:inline-flex; align-items:center; text-decoration:none; color:var(--color-ink);" aria-label="Notifications">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                    </svg>
                    <c:if test="${not empty unreadNotificationCount and unreadNotificationCount > 0}">
                        <span style="position:absolute; top:-6px; right:-8px; background:var(--color-danger); color:#fff; font-size:0.7rem; font-weight:700; border-radius:10px; padding:1px 5px; min-width:16px; text-align:center;">${unreadNotificationCount}</span>
                    </c:if>
                </a>
                <a href="${ctx}/change-password" style="font-size:0.85rem;color:var(--color-ink-soft);text-decoration:none;">Change password</a>
            </div>
        </header>
        <main class="page-body" id="main-content">
